local bv = Instance.new("BodyVelocity")
bv.MaxForce = Vector3.new(0,0,0)
bv.P        = 9000
bv.Velocity = Vector3.zero

local tweenTarget = nil
local lastKey     = 0

local function bvAttach(char)
    local hrp = char:WaitForChild("HumanoidRootPart")
    bv.Parent   = hrp
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(0,0,0)
end
localPlayer.CharacterAdded:Connect(bvAttach)
do
    local initC = getChar()
    if initC then
        local h0 = initC:FindFirstChild("HumanoidRootPart")
        if h0 then bv.Parent = h0 end
    end
end

UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    local k = inp.KeyCode
    if k==Enum.KeyCode.W or k==Enum.KeyCode.A or k==Enum.KeyCode.S
       or k==Enum.KeyCode.D or k==Enum.KeyCode.Space then
        lastKey     = tick()
        tweenTarget = nil
    end
end)

RunService.Heartbeat:Connect(function()
    if not S.TweenEnabled or tick()-lastKey < 0.3 or not tweenTarget then
        bv.MaxForce = Vector3.new(0,0,0)
        bv.Velocity = Vector3.zero
        return
    end
    local hrp = getHRP()
    if not hrp or not hrp.Parent then
        bv.MaxForce = Vector3.new(0,0,0)
        return
    end
    if bv.Parent ~= hrp then bv.Parent = hrp end
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    local pos = hrp.Position
    local rp  = RaycastParams.new()
    rp.FilterDescendantsInstances = { getChar() }
    rp.FilterType  = Enum.RaycastFilterType.Exclude
    rp.IgnoreWater = true
    local ty  = tweenTarget.Y + 6
    local ray = workspace:Raycast(pos + Vector3.new(0,10,0), Vector3.new(0,-50,0), rp)
    if ray then ty = math.max(ty, ray.Position.Y + 6) end
    local dest = Vector3.new(tweenTarget.X, ty, tweenTarget.Z)
    local diff = dest - pos
    if diff.Magnitude < 2 then
        bv.Velocity = Vector3.zero
        return
    end
    local vel = diff.Unit * 19
    local dy  = dest.Y - pos.Y
    if dy > 0 then
        vel = vel + Vector3.new(0, math.clamp(dy * 1.3, 0, 13), 0)
    end
    bv.Velocity = vel
end)

