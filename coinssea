-- ══════════════════════════════════════════════
--  AUTO FARM — TWEEN TARGETING
-- ══════════════════════════════════════════════
task.spawn(function()
    local stuckCount = 0
    local lastTPos   = nil
    while true do
        task.wait(0.05)
        if not S.FarmEnabled or not S.TweenEnabled then
            tweenTarget = nil
            task.wait(0.1)
            continue
        end
        local hrp = getHRP()
        if not hrp then task.wait(0.1); continue end
        local pos  = hrp.Position
        local best = nil
        -- Scan plant boxes (without seed)
        for i = #plantBoxes, 1, -1 do
            local pb = plantBoxes[i]
            if not pb.model or not pb.model.Parent then
                table.remove(plantBoxes, i); continue
            end
            if S.TweenTarget == "Box" or S.TweenTarget == "Both" then
                local mag = (pb.part.Position - pos).Magnitude
                if mag <= S.TweenRange and not pb.model:FindFirstChild("Seed") then
                    if not best or mag < best.d then
                        best = {d=mag, p=pb.part.Position}
                    end
                end
            end
        end
        -- Scan crops
        if S.TweenTarget == "Bush" or S.TweenTarget == "Both" then
            local crops = workspace:FindFirstChild("Crops")
            if crops then
                for _, v in ipairs(crops:GetDescendants()) do
                    if v:IsA("Model") and v:GetAttribute("EntityID") then
                        local bp = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart", true)
                        if bp then
                            local mag = (bp.Position - pos).Magnitude
                            if mag <= S.TweenRange and (not best or mag < best.d) then
                                best = {d=mag, p=bp.Position}
                            end
                        end
                    end
                end
            end
        end
        if best then
            if lastTPos and (lastTPos - best.p).Magnitude < 1 then
                stuckCount = stuckCount + 1
                if stuckCount >= 60 then
                    tweenTarget = nil; stuckCount = 0
                    task.wait(0.2); continue
                end
            else
                lastTPos   = best.p
                stuckCount = 0
            end
            tweenTarget = (best.p - pos).Magnitude > 2 and best.p or nil
        else
            tweenTarget = nil
            lastTPos    = nil
        end
    end
end)

