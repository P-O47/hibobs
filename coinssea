local function mkSep(page, txt)
    if txt then
        local l = Instance.new("TextLabel")
        l.Size               = UDim2.new(1, 0, 0, BH - 10)
        l.BackgroundTransparency = 1
        l.Text               = "── " .. txt .. " ──"
        l.TextColor3         = Color3.fromRGB(100, 75, 155)
        l.Font               = Enum.Font.GothamBold
        l.TextSize           = FS - 1
        l.Parent             = page
    else
        local f = Instance.new("Frame")
        f.Size               = UDim2.new(1, 0, 0, 1)
        f.BackgroundColor3   = Color3.fromRGB(55, 40, 85)
        f.BorderSizePixel    = 0
        f.Parent             = page
    end
end

local function mkToggle(page, text, stateKey, onChange)
    local row = Instance.new("Frame")
    row.Size                = UDim2.new(1, 0, 0, BH)
    row.BackgroundTransparency = 1
    row.Parent              = page
    local hl = Instance.new("UIListLayout")
    hl.FillDirection        = Enum.FillDirection.Horizontal
    hl.VerticalAlignment    = Enum.VerticalAlignment.Center
    hl.Parent               = row

    local lbl = Instance.new("TextLabel")
    lbl.Size                = UDim2.new(1, -60, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text                = text
    lbl.TextColor3          = Color3.fromRGB(200, 192, 220)
    lbl.Font                = Enum.Font.Gotham
    lbl.TextSize            = FS
    lbl.TextXAlignment      = Enum.TextXAlignment.Left
    lbl.Parent              = row

    local initOn = stateKey and S[stateKey] or false
    local b = Instance.new("TextButton")
    b.Size                  = UDim2.new(0, 56, 0, BH - 5)
    b.BackgroundColor3      = initOn and Color3.fromRGB(0,160,80) or Color3.fromRGB(50,38,72)
    b.TextColor3            = Color3.fromRGB(240, 232, 255)
    b.Font                  = Enum.Font.GothamBold
    b.TextSize              = FS - 1
    b.Text                  = initOn and "ON" or "OFF"
    b.AutoButtonColor       = true
    b.Parent                = row
    do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,5); c.Parent = b end

    b.MouseButton1Click:Connect(function()
        if stateKey then
            S[stateKey]      = not S[stateKey]
            b.Text           = S[stateKey] and "ON" or "OFF"
            b.BackgroundColor3 = S[stateKey]
                and Color3.fromRGB(0,160,80) or Color3.fromRGB(50,38,72)
        end
        if onChange then onChange(stateKey and S[stateKey]) end
    end)
    return b
end

-- Cycling dropdown (tap to cycle options)
local function mkDropdown(page, options, stateKey)
    local init = S[stateKey] or options[1]
    local b    = Instance.new("TextButton")
    b.Size               = UDim2.new(1, 0, 0, BH)
    b.BackgroundColor3   = Color3.fromRGB(35, 27, 55)
    b.TextColor3         = Color3.fromRGB(210, 198, 240)
    b.Font               = Enum.Font.Gotham
    b.TextSize           = FS
    b.Text               = "▾  " .. tostring(init)
    b.TextXAlignment     = Enum.TextXAlignment.Left
    b.AutoButtonColor    = true
    b.Parent             = page
    do
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,5); c.Parent = b
        local up = Instance.new("UIPadding"); up.PaddingLeft = UDim.new(0,6); up.Parent = b
    end
    local idx = 1
    for i, o in ipairs(options) do
        if o == init then idx = i; break end
    end
    b.MouseButton1Click:Connect(function()
        idx        = idx % #options + 1
        S[stateKey] = options[idx]
        b.Text     = "▾  " .. options[idx]
    end)
    return b
end

-- Numeric input row
local function mkInput(page, labelText, stateKey, minV, maxV)
    local row = Instance.new("Frame")
    row.Size                = UDim2.new(1, 0, 0, BH)
    row.BackgroundTransparency = 1
    row.Parent              = page
    local hl = Instance.new("UIListLayout")
    hl.FillDirection        = Enum.FillDirection.Horizontal
    hl.VerticalAlignment    = Enum.VerticalAlignment.Center
    hl.Parent               = row

    local lbl = Instance.new("TextLabel")
    lbl.Size                = UDim2.new(0.6, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text                = labelText
    lbl.TextColor3          = Color3.fromRGB(175, 168, 200)
    lbl.Font                = Enum.Font.Gotham
    lbl.TextSize            = FS - 1
    lbl.TextXAlignment      = Enum.TextXAlignment.Left
    lbl.Parent              = row

    local tb = Instance.new("TextBox")
    tb.Size                 = UDim2.new(0.38, 0, 0, BH - 7)
    tb.BackgroundColor3     = Color3.fromRGB(38, 28, 60)
    tb.TextColor3           = Color3.fromRGB(220, 212, 245)
    tb.Font                 = Enum.Font.Gotham
    tb.TextSize             = FS
    tb.Text                 = tostring(S[stateKey])
    tb.BorderSizePixel      = 0
    tb.Parent               = row
    do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,4); c.Parent = tb end

    tb.FocusLost:Connect(function()
        local v = tonumber(tb.Text)
        if v then
            if minV then v = math.max(v, minV) end
            if maxV then v = math.min(v, maxV) end
            S[stateKey] = v
            tb.Text     = tostring(v)
        else
            tb.Text = tostring(S[stateKey])
        end
    end)
    return row
end

-- Plain button
local function mkBtn(page, text, onClick)
    local b = Instance.new("TextButton")
    b.Size               = UDim2.new(1, 0, 0, BH)
    b.BackgroundColor3   = Color3.fromRGB(52, 38, 82)
    b.TextColor3         = Color3.fromRGB(220, 208, 255)
    b.Font               = Enum.Font.GothamBold
    b.TextSize           = FS
    b.Text               = text
    b.AutoButtonColor    = true
    b.Parent             = page
    do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,5); c.Parent = b end
    b.MouseButton1Click:Connect(onClick)
    return b
end

