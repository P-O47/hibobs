local tabBtns  = {}

for i, name in ipairs(TABS) do
    pages[i] = makePage()
    local tb = Instance.new("TextButton")
    tb.Size            = UDim2.new(1 / #TABS, -1, 1, -2)
    tb.BackgroundColor3 = Color3.fromRGB(26, 18, 42)
    tb.TextColor3      = Color3.fromRGB(130, 118, 165)
    tb.Font            = Enum.Font.GothamBold
    tb.TextSize        = 9
    tb.Text            = name
    tb.LayoutOrder     = i
    tb.Parent          = tabBar
    do local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,3); c.Parent = tb end
    tabBtns[i] = tb
end

local currentTab = 1
local function switchTab(idx)
    currentTab = idx
    for i = 1, #TABS do
        pages[i].Visible   = i == idx
        tabBtns[i].BackgroundColor3 = i == idx
            and Color3.fromRGB(88, 52, 165)
            or  Color3.fromRGB(26, 18, 42)
        tabBtns[i].TextColor3 = i == idx
            and Color3.fromRGB(230, 215, 255)
            or  Color3.fromRGB(120, 110, 155)
    end
end
for i, b in ipairs(tabBtns) do
    b.MouseButton1Click:Connect(function() switchTab(i) end)
end

