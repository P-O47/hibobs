--  PLANT BOX GRID — DATA
-- ══════════════════════════════════════════════
local gridVizFolder = Instance.new("Folder")
gridVizFolder.Name   = "FeeGridViz"
gridVizFolder.Parent = workspace.CurrentCamera

local vizPool       = {}
local gridSet       = {}   -- [n][k] = true  (box exists at cell)
local gridCooldown  = {}   -- [n][k] = timestamp (recently placed)
local gridOX        = 0
local gridOZ        = 0
local gridReady     = false
local lastGridRefresh  = 0
local lastVizUpdate    = 0
local lastGridPlace    = 0

local rpGrid = RaycastParams.new()
rpGrid.FilterType  = Enum.RaycastFilterType.Exclude
rpGrid.IgnoreWater = false

local function rpUpdateFilter()
    local t  = {gridVizFolder}
    local pw = workspace:FindFirstChild("Players")
    if pw then table.insert(t, pw) end
    rpGrid.FilterDescendantsInstances = t
end
rpUpdateFilter()

local function setG(t, n, k, v)
    if not t[n] then t[n] = {} end
    t[n][k] = v
end
local function getG(t, n, k)
    return t[n] and t[n][k]
end

local function initGrid()
    local hrp = getHRP()
    if not hrp then return false end
    gridOX    = math.round(hrp.Position.X / GRID_SIZE) * GRID_SIZE
    gridOZ    = math.round(hrp.Position.Z / GRID_SIZE) * GRID_SIZE
    gridReady = true
    return true
end

local gridDeployConn
local function refreshGridSet()
    for k in pairs(gridSet) do gridSet[k] = nil end
    local dep = workspace:FindFirstChild("Deployables")
    if not dep then return end
    if gridDeployConn then gridDeployConn:Disconnect() end
    local function handleBox(v)
        if v.Name ~= "Plant Box" then return end
        local p  = v:GetPivot().Position
        local n  = math.round((p.X - gridOX) / GRID_SIZE)
        local k2 = math.round((p.Z - gridOZ) / GRID_SIZE)
        setG(gridSet, n, k2, true)
        setG(gridCooldown, n, k2, nil)
    end
    gridDeployConn = dep.ChildAdded:Connect(handleBox)
    for _, v in ipairs(dep:GetChildren()) do handleBox(v) end
end

local function getVizRay(x, z, y)
    return workspace:Raycast(
        Vector3.new(x, y + S.RaycastHeight, z),
        Vector3.new(0, -500, 0),
        rpGrid
    )
end

local function ensureVizPool(n)
    while #vizPool < n do
        local p = Instance.new("Part")
        p.Size       = Vector3.new(GRID_SIZE - 0.3, 0.1, GRID_SIZE - 0.3)
        p.Anchored   = true
        p.CanCollide = false
        p.CanQuery   = false
        p.CanTouch   = false
        p.Material   = Enum.Material.Neon
        p.Parent     = nil
        table.insert(vizPool, p)
    end
end

-- ══════════════════════════════════════════════
--  GRID VISUALIZER (Heartbeat)
-- ══════════════════════════════════════════════
RunService.Heartbeat:Connect(function()
    local now = os.clock()
    if not gridReady then
        if not initGrid() then return end
        refreshGridSet()
    end
    if now - lastGridRefresh > 15 then
        lastGridRefresh = now
        rpUpdateFilter()
        refreshGridSet()
    end
    if now - lastVizUpdate < 0.15 then return end
    lastVizUpdate = now

    local hrp = getHRP()
    if not hrp then return end
    local pos = hrp.Position
    local vr  = S.VisualRadius
    local pr  = S.PlaceRadius
    local mx  = 50000 / GRID_SIZE

    local xMin = math.max(-mx, math.floor((pos.X - gridOX - vr) / GRID_SIZE))
    local xMax = math.min( mx, math.ceil( (pos.X - gridOX + vr) / GRID_SIZE))
    local zMin = math.max(-mx, math.floor((pos.Z - gridOZ - vr) / GRID_SIZE))
    local zMax = math.min( mx, math.ceil( (pos.Z - gridOZ + vr) / GRID_SIZE))

    ensureVizPool((xMax - xMin + 1) * (zMax - zMin + 1))

    local vi = 1
    for n = xMin, xMax do
        for k = zMin, zMax do
            if vi > #vizPool then break end
            local wx   = gridOX + n * GRID_SIZE
            local wz   = gridOZ + k * GRID_SIZE
            local part = vizPool[vi]; vi = vi + 1
            local inP, inB

            if S.GridShape == "Circle" then
                local d2 = (wx - pos.X)^2 + (wz - pos.Z)^2
                inP = d2 <= pr * pr
                inB = not inP and d2 <= (pr + GRID_SIZE)^2
            else
                local dx = math.abs(wx - pos.X)
                local dz = math.abs(wz - pos.Z)
                inP = dx <= pr and dz <= pr
                inB = not inP and dx <= pr + GRID_SIZE and dz <= pr + GRID_SIZE
            end

            if S.GridViz and (inP or inB) and not getG(gridSet, n, k) then
                local ray = getVizRay(wx, wz, pos.Y)
                if ray then
                    local inst      = ray.Instance
                    local isTerrain = inst:IsA("Terrain")
                    local ancestorModel = inst:FindFirstAncestorWhichIsA("Model")
                    local isDock    = string.lower(inst.Name) == "dock"
                        or (ancestorModel and string.lower(ancestorModel.Name) == "dock")
                    if (isTerrain or isDock) and ray.Material ~= Enum.Material.Water then
                        part.Position    = Vector3.new(wx, ray.Position.Y + 0.5, wz)
                        part.Color       = inP and Color3.fromRGB(0,255,100) or Color3.fromRGB(255,255,100)
                        part.Transparency = inP and 0.3 or 0.45
                        part.Parent      = gridVizFolder
                        continue
                    end
                end
            end
            part.Parent = nil
        end
    end
    for i = vi, #vizPool do vizPool[i].Parent = nil end
end)

-- ══════════════════════════════════════════════
--  GRID PLACEMENT LOOP
-- ══════════════════════════════════════════════
task.spawn(function()
    while true do
        task.wait(math.max(0.05, S.PlaceCooldown))
        if not S.PlaceEnabled or not Packets or not gridReady then continue end
        local hrp = getHRP(); if not hrp then continue end
        local pos = hrp.Position
        local now = os.clock()
        if now - lastGridPlace < S.PlaceCooldown then continue end
        local pr  = S.PlaceRadius
        local mx  = 50000 / GRID_SIZE
        local xMin = math.max(-mx, math.floor((pos.X - gridOX - pr) / GRID_SIZE))
        local xMax = math.min( mx, math.ceil( (pos.X - gridOX + pr) / GRID_SIZE))
        local zMin = math.max(-mx, math.floor((pos.Z - gridOZ - pr) / GRID_SIZE))
        local zMax = math.min( mx, math.ceil( (pos.Z - gridOZ + pr) / GRID_SIZE))
        for n = xMin, xMax do
            for k = zMin, zMax do
                if getG(gridSet, n, k) then continue end
                local cd = getG(gridCooldown, n, k)
                if cd and now - cd < 1 then continue end
                local wx = gridOX + n * GRID_SIZE
                local wz = gridOZ + k * GRID_SIZE
                -- Shape boundary
                if S.GridShape == "Circle" then
                    if (wx-pos.X)^2 + (wz-pos.Z)^2 > pr*pr then continue end
                else
                    if math.abs(wx-pos.X) > pr or math.abs(wz-pos.Z) > pr then continue end
                end
                local ray = getVizRay(wx, wz, pos.Y)
                if ray then
                    local inst      = ray.Instance
                    local isTerrain = inst:IsA("Terrain")
                    local am        = inst:FindFirstAncestorWhichIsA("Model")
                    local isDock    = string.lower(inst.Name) == "dock"
                        or (am and string.lower(am.Name) == "dock")
                    if (isTerrain or isDock) and ray.Material ~= Enum.Material.Water then
                        pcall(function()
                            Packets.PlaceStructure.send({
                                buildingName = "Plant Box",
                                cframe       = CFrame.new(ray.Position),
                            })
                        end)
                        setG(gridCooldown, n, k, now)
                        lastGridPlace = now
                        return
                    end
                end
            end
        end
    end
end)

